{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dordekha",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static assets (logo, favicon, the small progressive-enhancement script).
  // Served straight from the edge, before the Worker runs.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dordekha",
      "database_id": "b8c959ee-d5da-41cb-a336-cfea795cf160",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "0c856163da4147bb9ff14a1d01f2962f"
    }
  ],

  // Service binding for the ingest chain.
  //
  // A Worker cannot fetch its own workers.dev hostname: the edge rejects the
  // subrequest with error 1042 before the code runs. A service binding is
  // the supported way for a Worker to call itself, and it skips DNS and the
  // public routing path entirely.
  "services": [
    {
      "binding": "SELF",
      "service": "dordekha"
    }
  ],

  "triggers": {
    // The heartbeat that drives the ingest, and the daily upkeep that
    // applies the indexes of migration 0004 and refreshes the master data.
    // 00:02 UTC is 06:02 in Bangladesh, two minutes after the D1 read
    // quota resets.
    "crons": ["* * * * *", "2 0 * * *"]
  },

  // The name the site answers on. A custom domain and not a route: the
  // certificate for the name is issued for it, and the worker is reached
  // inside cloudflare instead of over the public internet.
  //
  // The workers.dev address stays on as well: the pages front forwards to
  // it, and it is the address that does not depend on anybody's free
  // domain service.
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dordekha.dpdns.org",
      "custom_domain": true
    }
  ],

  "vars": {
    "SITE_ORIGIN": "https://dordekha.pages.dev",
    "SOURCE_NAME": "কৃষি মন্ত্রণালয় / কৃষি বিপণন অধিদপ্তর (DAM)",
    "SOURCE_API": "https://moa-services.com/agri-service",
    "TELEGRAM_CHANNEL": "-1004442758387",
    "BKASH_NUMBER": "01730534955"
  }
}
